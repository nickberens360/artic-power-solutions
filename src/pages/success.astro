---
import Layout from '../layouts/Layout.astro';
import {SITE_DESCRIPTION, SITE_TITLE} from "../consts";
---
<!DOCTYPE html>
<Layout
    title={SITE_TITLE}
    description={SITE_DESCRIPTION}
    noindex
>
<main class="min-h-screen flex items-center justify-center text-center py-16 md:py-24 bg-card">
  <div class="container mx-auto px-6">
    <div class="max-w-2xl mx-auto bg-background border border-border p-8 md:p-12 rounded-xl shadow-sm">
      <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4">Thank You!</h1>
      <p class="text-lg text-muted-foreground mb-8">
        Your message has been sent successfully. We will get back to you shortly.
      </p>
      <a href="/" class="btn btn-primary">
        Return to Homepage
      </a>
    </div>
  </div>
</main>
</Layout>
