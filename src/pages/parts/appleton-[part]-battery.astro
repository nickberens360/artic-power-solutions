---
// One landing page per Appleton battery part number (e.g. /parts/appleton-139082-battery),
// written to rank for the number printed on the customer's old pack. Each pack has a Contact Sales button, like the part pages.
import Layout from '../../layouts/Layout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import ProductSchema from '../../components/ProductSchema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllProducts } from '../../lib/products.js';
import { APPLETON_BATTERY_PAGES, appletonBatteryPagePath } from '../../data/appleton-battery-pages.js';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return Object.entries(APPLETON_BATTERY_PAGES)
    .map(([part, page]) => ({ part, page, options: products.filter((p) => p.partNumber === part) }))
    .filter(({ options }) => options.length > 0)
    .map(({ part, page, options }) => ({ params: { part }, props: { part, page, options } }));
}

const { part, page, options } = Astro.props;

const money = (amount: string | number, currency = 'USD') =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency, maximumFractionDigits: 0 }).format(Number(amount));
const priceOf = (o: any) => Number(o.priceRange.minVariantPrice.amount);
const sorted = [...options].sort((a, b) => priceOf(a) - priceOf(b));
const fromPrice = money(priceOf(sorted[0]));
const spec = (o: any, label: string) => o.specs?.find((s: any) => s.label === label)?.value;
const chemistry = (o: any) => (o.categories ?? []).find((c: string) => c === 'NiCd' || c === 'NiMH');

const rows = [
  { label: 'Price', value: (o: any) => money(priceOf(o)) },
  { label: 'Voltage', value: (o: any) => spec(o, 'Voltage') },
  { label: 'Capacity', value: (o: any) => spec(o, 'Capacity') },
  { label: 'Chemistry', value: (o: any) => spec(o, 'Chemistry') },
  ...(page.bestFor ? [{ label: 'Best for', value: (o: any) => page.bestFor[chemistry(o)] }] : []),
  { label: 'Availability', value: (o: any) => spec(o, 'Availability') },
].filter((r) => sorted.some((o) => r.value(o)));

const seoTitle = `Appleton ${part} Replacement Battery, ${page.titleSuffix} | ${SITE_TITLE}`;
const seoDescription = page.metaDescription(fromPrice);
const heroImage = sorted[0].images.edges[0]?.node.url;
const quoteMessage = `I'd like a quote for replacement batteries for Appleton #${part}.\n\nQuantity: `;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={seoTitle} description={seoDescription} image={heroImage}>
  <Fragment slot="head">
    {sorted.map((o) => (
      <ProductSchema part={{ data: {
        title: `${o.title} (replaces Appleton #${part})`,
        description: o.description,
        partNumber: part,
        heroImage: o.images.edges[0]?.node.url,
        price: o.priceRange.minVariantPrice.amount,
        currency: o.priceRange.minVariantPrice.currencyCode,
        inStock: typeof o.stock === 'number' ? o.stock > 0 : undefined,
      } }} />
    ))}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <SectionBlock>
    <Breadcrumbs
      class="mb-8"
      items={[
        { name: 'Parts', path: '/parts' },
        { name: `Appleton #${part} Replacement Battery`, path: appletonBatteryPagePath(part) },
      ]}
    />
    <article class="part-landing">
      <header class="title">
        <h1>{page.heading}</h1>
        <div class="part-number">Replaces Appleton Part <strong>#{part}</strong></div>
        <p class="intro">{page.intro}</p>
      </header>

      <h2>{sorted.length > 1 ? 'Choose your pack' : 'Specifications'}</h2>
      <div class="table-wrap">
        <table class="spec-table">
          {sorted.length > 1 && (
            <thead>
              <tr><td></td>{sorted.map((o) => <th scope="col">{o.title}</th>)}</tr>
            </thead>
          )}
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {sorted.map((o) => <td>{r.value(o) ?? ''}</td>)}
              </tr>
            ))}
            <tr>
              <td></td>
              {sorted.map((o) => (
                <td>
                  <a
                    class="buy-button contact-sales-link"
                    href="#contact"
                    data-equipment={page.equipment}
                    data-message={`I'd like a quote for the ${o.title} (replaces Appleton #${part}).\n\nQuantity: `}
                  >Contact Sales</a>
                  <a class="details-link" href={`/parts/${o.handle}`}>Full product details</a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>

      {page.chooser && <p><strong>Not sure which to pick?</strong> {page.chooser}</p>}
      {page.why && <p><strong>{page.why.title}:</strong> {page.why.text}</p>}

      <h2>Will this battery fit my unit?</h2>
      <p>
        Check the label on your current battery for <strong>#{part}</strong>. Or send us a photo of the label and
        we'll confirm the match before you order.
        <a href="#contact" class="underline contact-sales-link" data-equipment={page.equipment} data-message={quoteMessage}>Contact us</a>
      </p>

      <h2>Signs your {part} pack is failing</h2>
      <ul>{page.signs.map((s: string) => <li>{s}</li>)}</ul>

      <h2>{page.fleet ? 'Running a fleet?' : 'Buying for a plant?'}</h2>
      <p>
        {page.fleet
          ? 'Keep a charged spare on the shelf so a mover never sits idle. We offer multi-pack pricing and accept purchase orders.'
          : 'We accept purchase orders and quote multiple packs.'}
      </p>
      <a class="buy-button secondary contact-sales-link" href="#contact" data-equipment={page.equipment} data-message={quoteMessage}>Request a quote</a>

      <h2>FAQ</h2>
      <dl class="faq">
        {page.faq.map((f: any) => (<Fragment><dt>{f.q}</dt><dd>{f.a}</dd></Fragment>))}
      </dl>
    </article>
    <p class="text-sm text-center text-muted-foreground max-w-[600px] mx-auto mt-10">Artic Power Solutions is an independent service provider. RollMover™ and CartMover™ are trademarks of Appleton Mfg. Artic Power Solutions is not affiliated with, sponsored by, or endorsed by Appleton Mfg.</p>
  </SectionBlock>
</Layout>

<script>
  // Quote/contact links scroll to the footer form and pre-fill it (only empty fields), same as part pages.
  document.querySelectorAll<HTMLAnchorElement>('.contact-sales-link').forEach((link) => {
    link.addEventListener('click', () => {
      const form = document.querySelector<HTMLFormElement>('#contact form');
      if (!form) return;
      const setIfEmpty = (name: string, value?: string) => {
        const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (field && value && !field.value) field.value = value;
      };
      setIfEmpty('inquiry_type', 'Parts');
      setIfEmpty('rollmover_model', link.dataset.equipment);
      setIfEmpty('message', link.dataset.message);
      setTimeout(() => (form.elements.namedItem('name') as HTMLInputElement | null)?.focus({ preventScroll: true }), 400);
    });
  });
</script>

<style>
  .part-landing { max-width: 820px; margin: 0 auto; color: hsl(var(--foreground)); }
  .title { text-align: center; margin-bottom: 1.5rem; }
  .title h1 { margin: 0 0 0.75rem; line-height: 1.15; }
  .part-number {
    display: inline-block; margin: 0 0 1rem; padding: 0.4rem 0.9rem;
    border: 1px solid var(--accent); border-radius: 999px; color: var(--accent);
    font-size: 1.1rem; line-height: 1.3; letter-spacing: 0.02em;
  }
  .intro { font-size: 1.15rem; }
  .part-landing h2 { margin: 2rem 0 0.75rem; font-size: 1.5rem; }
  .part-landing p { margin: 0 0 1rem; }
  .part-landing ul { list-style: disc; padding-left: 1.5em; margin-bottom: 1rem; }
  .table-wrap { overflow-x: auto; }
  .spec-table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 1.5rem; }
  .spec-table th, .spec-table td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.15); vertical-align: top; }
  .spec-table tbody th { width: 28%; font-weight: 600; color: hsl(var(--muted-foreground)); }
  .spec-table thead th { color: hsl(var(--foreground)); font-size: 1.05rem; }
  .buy-button {
    display: inline-block; background-color: var(--accent); color: white !important; padding: 0.7rem 1.25rem;
    font-weight: bold; border-radius: 4px; text-decoration: none; transition: background-color 0.2s;
  }
  .buy-button:hover { background-color: var(--accent-dark); }
  .buy-button.secondary { background-color: transparent; border: 1px solid var(--accent); }
  .details-link { display: block; margin-top: 0.5rem; font-size: 0.9rem; color: hsl(var(--muted-foreground)); text-decoration: underline; }
  .faq dt { font-weight: 700; margin-top: 1rem; }
  .faq dd { margin: 0.25rem 0 0; color: hsl(var(--muted-foreground)); }
</style>
