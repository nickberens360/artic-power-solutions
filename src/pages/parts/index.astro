---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts } from '../../lib/products.js';
import { APPLETON_BATTERY_PAGES, appletonBatteryPagePath } from '../../data/appleton-battery-pages.js';

// Products come from MoverBattery's catalog (see src/lib/products.js)
const products = await getAllProducts();
const partPages = Object.entries(APPLETON_BATTERY_PAGES).filter(([part]) => products.some((p) => p.partNumber === part));
---

<Layout
    title="RollMover™ Compatible Battery Packs | Artic Power Solutions"
    description="Compatible NiMH and NiCd replacement battery packs for RollMover™ equipment, cross-referenced to Appleton part numbers. Request a quote today."
>
  <main class="container">
    <div class="title-section">
      <h1>Our Compatible Parts</h1>
      <p>
        High-quality, reliable replacement parts to keep your equipment running
        at its best.
      </p>
      {partPages.length > 0 && (
        <p class="part-links">
          Shop by Appleton part number:
          {partPages.map(([part, page]) => (
            <a href={appletonBatteryPagePath(part)}>#{part} <span>({page.titleSuffix})</span></a>
          ))}
        </p>
      )}
    </div>

    {products.length > 0 ? (
        <div class="product-grid">
          {products.map((product) => (
              <ProductCard product={product} />
          ))}
        </div>
    ) : (
        <p class="text-muted-foreground text-center">
          Need a part for your RollMover&trade; compatible equipment? Batteries, drive wheels, motors, controls and more.
          <a href="#contact" class="underline">Contact us for a quote</a> and we'll get back to you quickly.
        </p>
    )}
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: auto;
    padding: 4rem 1rem;
  }
  .title-section {
    text-align: center;
    margin-bottom: 3rem;
  }
  .title-section h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    color: hsl(var(--foreground));
  }
  .title-section > p {
    color: hsl(var(--muted-foreground));
    font-size: 1.125rem;
  }
  .part-links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
  }
  .part-links a {
    color: var(--accent);
    text-decoration: underline;
  }
  .part-links span {
    color: hsl(var(--muted-foreground));
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
</style>