---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts } from '../../lib/products.js';

// Products come from MoverBattery's catalog (see src/lib/products.js)
const products = await getAllProducts();
---

<Layout
    title="RollMover™ Compatible Battery Packs | Artic Power Solutions"
    description="Compatible NiMH and NiCd replacement battery packs for RollMover™ equipment, cross-referenced to Appleton part numbers. Request a quote today."
>
  <main class="container">
    <div class="title-section text-white">
      <h1>Our Compatible Parts</h1>
      <p>
        High-quality, reliable replacement parts to keep your equipment running
        at its best.
      </p>
    </div>

    {products.length > 0 ? (
        <div class="product-grid">
          {products.map((product) => (
              <ProductCard product={product} />
          ))}
        </div>
    ) : (
        <p class="text-white text-center">
          Need a part for your RollMover&trade; compatible equipment? Batteries, drive wheels, motors, controls and more.
          <a href="#contact" class="underline">Contact us for a quote</a> and we'll get back to you quickly.
        </p>
    )}
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: auto;
    padding: 2rem 1rem;
  }
  .title-section {
    text-align: center;
    margin-bottom: 3rem;
  }
  .title-section h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
</style>