---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {SITE_TITLE, SITE_DESCRIPTION} from '../../consts';
import {getCollection} from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import {Image} from 'astro:assets';
import SectionBlock from "../../components/SectionBlock.astro";
import OrganizationSchema from '../../components/OrganizationSchema.astro';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
      title={`RollMover™ Repair & Maintenance Guides | ${SITE_TITLE}`}
      description="Troubleshooting guides, maintenance checklists and parts advice for RollMover™ compatible equipment from Artic Power Solutions."
  >
    <OrganizationSchema slot="head" />
  </BaseHead>
</head>
<body>
<Header/>
<main>
  <SectionBlock>
    <Fragment>
      <!-- Replace the ul/li structure with more semantic section/article elements -->
      <h1 class="text-4xl md:text-5xl font-bold text-foreground text-center mb-12">RollMover™ Repair &amp; Maintenance Guides</h1>
      <section class="flex flex-wrap m-0 p-0 gap-y-8 md:gap-x-8">
        {
          posts.map((post, index) => (
              <article
                  class:list={[
                    'bg-card border border-card-border p-4 rounded-xl w-full hover:shadow-md transition-shadow',
                    {
                      'md:w-[calc(50%-1rem)]': index > 0,
                      'text-center': index > 0,
                      'mb-4 text-center': index === 0,
                    },
                  ]}
              >
                <a
                    href={`/blog/${post.id.replace(/\.md$/, '')}`}
                    class="block no-underline group transition-all duration-200 ease-in-out"
                >
                  {post.data.heroImage && (
                      <Image
                          width={720}
                          height={360}
                          src={post.data.heroImage}
                          alt={post.data.title}
                          class="w-full mb-2 rounded-xl group-hover:shadow-xl"
                      />
                  )}
                  <h3
                      class:list={[
                        'm-0 mt-2 text-foreground font-semibold leading-tight break-words overflow-wrap-anywhere group-hover:text-accent',
                        {
                          'text-2xl md:text-4xl': index === 0,
                        },
                      ]}
                  >
                    {post.data.title}
                  </h3>
                  <p
                      class="text-sm text-muted-foreground mt-1 mb-0"
                  >
                    <FormattedDate date={post.data.pubDate}/>
                  </p>
                </a>
              </article>
          ))
        }
      </section>
    </Fragment>
  </SectionBlock>
</main>
<Footer/>
</body>
</html>
