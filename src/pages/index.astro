---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContentCard from '../components/ContentCard.astro';
import CalloutBox from '../components/CalloutBox.astro';
import {Image} from 'astro:assets';
import articLogoIcon from '../assets/artic-logo-icon.png';
import rollMoverIllustration from '../assets/rollMoverIllustration.png';
import compatibleBatteries from '../assets/compatible-batteries.png';
import vintageWarehouse from '../assets/vintage-warehouse.jpg';
import {SITE_TITLE, SITE_DESCRIPTION} from '../consts';
import {getCollection} from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import SectionBlock from "../components/SectionBlock.astro";
import ImageWithContent from "../components/ImageWithContent.astro";
import TrustStrip from "../components/TrustStrip.astro";
import { APPLETON_BATTERY_PAGES, appletonBatteryPagePath } from '../data/appleton-battery-pages.js';

// Fetch and sort the latest 3 blog posts
const latestPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<Layout
    title={`RollMover™ & CartMover™ Replacement Batteries | ${SITE_TITLE}`}
    description="Compatible replacement batteries for Appleton RollMover™ and CartMover™ equipment, matched by part number. NiCd and NiMH packs, shipped UPS Ground nationwide."
    image={compatibleBatteries}
>
  <Hero
      title="Replacement Batteries for RollMover™ & CartMover™ Equipment"
      tagline="Compatible NiCd and NiMH packs matched to the Appleton part number on your current battery. Shipped UPS Ground anywhere in the US."
      buttonText="Find Your Battery"
      buttonUrl="/parts"
      secondaryButtonText="Ask About Fit"
      secondaryButtonUrl="#contact"
      disclaimerText="Artic Power Solutions is an independent supplier. RollMover™ and CartMover™ are trademarks of Appleton Mfg. We are not affiliated with Appleton Mfg."
      imageUrl="https://images.unsplash.com/photo-1727517786578-ff2bb896b852?q=80&w=2842&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
  />
  <TrustStrip />
  <main>
    <SectionBlock>
      <Fragment>
        <ImageWithContent />
      </Fragment>
    </SectionBlock>

    <SectionBlock tone="card">
      <Fragment>
        <div>
          <div class="text-center mb-12">
            <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-4">The Artic Power Solutions Advantage</h2>
          </div>

          <CalloutBox/>

          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            <ContentCard
                title="Fit Confirmed Before You Buy"
                description="Not sure which pack you have? Send us your model or a photo of the label and we'll confirm the match."
            />
            <ContentCard
                title="An Alternative to OEM"
                description="A cost-effective replacement for original packs, built to the same voltage as the battery it replaces."
            />
            <ContentCard
                title="Longer Runtime Options"
                description="NiMH packs store more energy at the same voltage, so operators get more work out of every charge."
            />
            <ContentCard
                title="Buying for a Plant?"
                description="Purchase orders and multi-pack quotes are available for fleets. Packs ship from MoverBattery, our battery store."
            />


          </div>
        </div>
      </Fragment>
    </SectionBlock>

    <SectionBlock>
      <Fragment>
        <div>
          <div class="text-center">
            <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-4">Find Your Battery by Appleton Part Number</h2>
            <p class="text-lg text-muted-foreground mb-10">Check the label on your current pack, then pick the matching number.</p>
            <div class="grid gap-4 md:grid-cols-3 max-w-[960px] mx-auto">
              {Object.entries(APPLETON_BATTERY_PAGES).map(([part, page]) => (
                <a
                    href={appletonBatteryPagePath(part)}
                    class="block rounded-xl border border-card-border bg-card px-6 py-5 text-left transition hover:border-primary hover:shadow-md"
                >
                  <span class="block text-sm text-muted-foreground">Replaces Appleton Mfg.</span>
                  <span class="block text-2xl font-bold text-foreground">#{part}</span>
                  <span class="block text-primary font-medium mt-1">{page.titleSuffix} battery &rarr;</span>
                </a>
              ))}
            </div>
            <p class="text-muted-foreground mt-8">
              Can't read the label or not sure which pack you have? <a href="#contact" class="text-primary underline">Send us your equipment model</a> and we'll match it for you.
              Or <a href="/parts" class="text-primary underline">browse all battery packs</a>.
            </p>
          </div>
        </div>
      </Fragment>
    </SectionBlock>

    <SectionBlock tone="card">
      <Fragment>
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-4">From Our Blog</h2>
          <p class="text-lg text-muted-foreground">Tips, guides, and insights to help you get the most out of your
            equipment.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                latestPosts.map(post => (
                    <a
                        href={`/blog/${post.id.replace(/\.md$/, '')}`}
                        class="group block bg-background border border-card-border rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden no-underline"
                    >
                        {post.data.heroImage && (
                            <Image
                                src={post.data.heroImage}
                                alt={post.data.title}
                                width={720}
                                height={360}
                                class="w-full h-48 object-cover rounded-none transition-transform duration-300 group-hover:scale-105"
                            />
                        )}
                      <div class="p-6">
                        <h3 class="text-xl font-semibold text-foreground mb-2 leading-tight group-hover:text-primary transition-colors">{post.data.title}</h3>
                        <p class="text-muted-foreground text-sm mb-4">
                          <FormattedDate date={post.data.pubDate}/>
                        </p>
                        <p class="text-muted-foreground text-base">{post.data.description}</p>
                      </div>
                    </a>
                ))
            }
        </div>
        <div class="text-center mt-12">
          <a
              href="/blog"
              class="btn btn-outline"
          >
            View All Articles
          </a>
        </div>
      </Fragment>
    </SectionBlock>

    <SectionBlock>
      <Fragment>
        <div class="flex flex-wrap items-center -mx-4">
          <div class="w-full md:w-1/3 px-8 mb-8 md:mb-0 text-center ">
            <Image
                src={articLogoIcon}
                alt="Artic Power Solutions Logo"
                class="w-48 h-48 mx-auto rounded-none object-contain"
            />
          </div>
          <div class="w-full md:w-2/3 px-4">
            <div class="mb-12">
              <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-4">About Artic Power Solutions</h2>
            </div>
            <p class="text-lg text-muted-foreground">
              <strong class="text-foreground">Artic Power Solutions supplies compatible replacement batteries for Appleton
                RollMover™ roll pushers and CartMover™ cart tuggers.</strong> We started because replacing an original pack
              was too often expensive and slow, and a worn-out battery shouldn't keep a working machine parked.
            </p>
            <p class="text-lg text-muted-foreground mb-4">
              Many of the plants that rely on this equipment are in the paper, converting and nonwovens industries. We know
              a mover that dies mid-shift holds up the whole line, so every pack we offer is matched to the Appleton part
              number it replaces.
            </p>
            <p class="text-lg text-muted-foreground">
              Our packs are sold through MoverBattery, our battery store, and ship UPS Ground anywhere in the US. Not sure
              which one you need? Ask us and we'll help you match it.
            </p>
          </div>
        </div>
      </Fragment>
    </SectionBlock>

  </main>
</Layout>
