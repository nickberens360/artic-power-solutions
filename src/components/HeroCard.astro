---
/**
 * Live-text blog hero card. Renders the kicker / title / subtitle as real
 * HTML on the striped brand background, so the words are crawlable,
 * accessible and editable from frontmatter. The matching social-share PNG
 * is generated by src/pages/og/blog/[...slug].png.ts.
 */
interface Props {
	kicker?: string;
	title: string;
	subtitle?: string;
	class?: string;
}

const { kicker, title, subtitle, class: className } = Astro.props;
---

<div class:list={['hero-card', className]}>
	<div class="hero-card__inner">
		<div class="hero-card__body">
			{kicker && <p class="hero-card__kicker">{kicker}</p>}
			<p class="hero-card__title">{title}</p>
			{subtitle && <p class="hero-card__subtitle">{subtitle}</p>}
		</div>
		<p class="hero-card__brand">Artic Power Solutions</p>
	</div>
</div>

<style>
	.hero-card {
		container-type: inline-size;
		width: 100%;
		border-radius: 0.75rem;
		overflow: hidden;
		text-align: left;
	}
	.hero-card__inner {
		aspect-ratio: 2 / 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 10cqi 7.6cqi 5cqi;
		background-color: #1f222b;
		background-image: repeating-linear-gradient(
			45deg,
			transparent 0 1.1cqi,
			rgb(255 255 255 / 0.035) 1.1cqi 2.2cqi
		);
		border-left: 1.4cqi solid #e11414;
		font-family: Inter, system-ui, -apple-system, sans-serif;
	}
	.hero-card p {
		margin: 0;
	}
	.hero-card__kicker {
		color: #e11414;
		font-size: 2.3cqi;
		font-weight: 500;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		margin-bottom: 1.6cqi !important;
	}
	.hero-card__title {
		color: #fff;
		font-size: 5.8cqi;
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.01em;
		max-width: 75cqi;
	}
	.hero-card__subtitle {
		color: #a3a8b5;
		font-size: 2.6cqi;
		font-weight: 500;
		line-height: 1.4;
		max-width: 66cqi;
		margin-top: 1.4cqi !important;
	}
	.hero-card__brand {
		color: #fff;
		font-size: 1.95cqi;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}

	/* Small cards (phones, narrow grid columns): drop the secondary lines
	   and scale up the title so it stays readable. */
	@container (max-width: 480px) {
		.hero-card__inner {
			justify-content: center;
			padding: 0 7.6cqi;
		}
		.hero-card__subtitle,
		.hero-card__brand {
			display: none;
		}
		.hero-card__kicker {
			font-size: 3.6cqi;
		}
		.hero-card__title {
			font-size: 8.5cqi;
			max-width: none;
		}
	}
</style>
