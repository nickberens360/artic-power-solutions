---
interface Props {
  id?: string;
  title?: string;
  class?: string;
  innerRounded?: boolean;
  /** Background band: "default" (white) or "card" (light gray), alternating like moverbattery.com */
  tone?: 'default' | 'card';
}

const { id, title, class: className, innerRounded, tone = 'default' } = Astro.props;
---

<section
    id={id}
    class:list={[
      "section-block py-16 md:py-24",
      tone === 'card' ? 'bg-card' : 'bg-background',
      className,
    ]}
>
  <div
    class:list={[
      "section-block__inner max-w-[1200px] mx-auto px-4",
      { "rounded-xl bg-card border border-card-border py-10 px-6 md:px-10": innerRounded },
    ]}
  >
    {title && <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-foreground">{title}</h2>}
    <slot />
  </div>
</section>
