---
import HeaderLink from './HeaderLink.astro';
import {Image} from 'astro:assets';
import articLogoIcon from '../assets/artic-logo-icon.png';
import cartIcon from '../assets/cart-icon.png';
import {SITE_TITLE} from '../consts';
import { isFeatureEnabled } from '../utils/featureFlags';
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} home`}>
      <Image
          class="brand-icon"
          src={articLogoIcon}
          alt=""
          width={36}
          height={36}
      />
      <span class="site-title"><span class="text-primary">Artic</span> Power Solutions</span>
    </a>
    <div class="flex items-center gap-2">
      <div class="internal-links desktop-nav">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/blog">Resources</HeaderLink>
        <HeaderLink href="/parts">Parts</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </div>
      <a href="#contact" class="btn btn-primary btn-sm desktop-nav header-cta">Contact Sales</a>
      {isFeatureEnabled('ENABLE_SHOP') && (
          <button
              class="cart-link"
              aria-label="Cart"
              id="cart-icon-button"
          >
            <Image
                src={cartIcon}
                alt="Shopping Cart"
                width="24"
                height="24"
                class="cart-img"
            />
            <span class="cart-badge">0</span>
          </button>
      )}
      <button
          class="hamburger-menu ml-4"
          aria-label="Menu"
      >
        <span class="hamburger-icon"></span>
        <span class="hamburger-icon"></span>
        <span class="hamburger-icon"></span>
      </button>
    </div>
  </nav>
  <div class="mobile-nav">
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/blog">Resources</HeaderLink>
    <HeaderLink href="/parts">Parts</HeaderLink>
    <HeaderLink href="/about">About</HeaderLink>
    <a href="#contact" class="mobile-cta">Contact Sales</a>
  </div>
</header>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        width: 100%;
        background: hsl(var(--background));
        border-bottom: 1px solid hsl(var(--border));
    }

    .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        height: 4rem;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: .6rem;
        text-decoration: none;
        color: hsl(var(--foreground));
    }

    .brand-icon {
        width: 36px;
        height: 36px;
        border-radius: 0;
    }

    .site-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .internal-links {
        display: flex;
        align-items: center;
        gap: .25rem;
        margin-right: .75rem;
    }

    .internal-links :global(a) {
        padding: .5rem .75rem;
        border-radius: 6px;
        color: hsl(var(--foreground));
        font-size: .95rem;
        font-weight: 500;
        text-decoration: none;
        transition: background-color .15s, color .15s;
    }

    .internal-links :global(a:hover) {
        background: hsl(var(--muted));
    }

    .internal-links :global(a.active) {
        color: hsl(var(--primary));
        text-decoration: none;
    }

    .cart-link {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: .5rem;
    }

    .cart-img {
        filter: invert(1);
    }

    .cart-badge {
        position: absolute;
        top: -10px;
        left: 10px;
        background-color: hsl(var(--primary));
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 12px;
        font-weight: bold;
        display: flex;
        justify-content: center;
        align-items: center;
        transform: scale(0);
        transition: transform 0.2s ease-in-out;
    }

    .cart-badge.has-items {
        transform: scale(1);
    }

    .hamburger-menu {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 22px;
        height: 16px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 10;
    }

    .hamburger-icon {
        display: block;
        width: 100%;
        height: 2px;
        background-color: hsl(var(--foreground));
        border-radius: 2px;
        transition: all 0.3s ease-in-out;
    }

    .mobile-nav {
        display: none;
        flex-direction: column;
        width: 100%;
        padding: .5rem 0 1rem;
        border-top: 1px solid hsl(var(--border));
        background: hsl(var(--background));
    }

    .mobile-nav :global(a) {
        color: hsl(var(--foreground));
        padding: 0.75rem 1rem;
        display: block;
        font-weight: 500;
        text-decoration: none;
    }

    .mobile-nav :global(a.active) {
        color: hsl(var(--primary));
    }

    .mobile-nav .mobile-cta {
        margin: .5rem 1rem 0;
        text-align: center;
        border-radius: 6px;
        background: hsl(var(--primary));
        color: white;
        font-weight: 600;
    }

    @media (max-width: 720px) {
        .desktop-nav {
            display: none;
        }

        .hamburger-menu, .mobile-nav.active {
            display: flex;
        }

        .site-title {
            font-size: 1.05rem;
        }
    }

    .hamburger-menu.active .hamburger-icon:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }

    .hamburger-menu.active .hamburger-icon:nth-child(2) {
        opacity: 0;
    }

    .hamburger-menu.active .hamburger-icon:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }
</style>

<script>
    import {cart} from '../lib/cart-store';

    document.addEventListener('DOMContentLoaded', () => {
        try {
            const hamburgerButton = document.querySelector('.hamburger-menu');
            const mobileNav = document.querySelector('.mobile-nav');
            const cartButton = document.getElementById('cart-icon-button');

        hamburgerButton?.addEventListener('click', () => {
            try {
                hamburgerButton.classList.toggle('active');
                mobileNav?.classList.toggle('active');
            } catch (error) {
                console.error('Error toggling mobile navigation:', error);
            }
        });

        // Add event listener to open cart drawer when cart icon is clicked
        cartButton?.addEventListener('click', () => {
            try {
                if (typeof window.openCartDrawer === 'function') {
                    window.openCartDrawer();
                }
            } catch (error) {
                console.error('Error opening cart drawer:', error);
            }
        });

        const badges = document.querySelectorAll('.cart-badge');
        const updateBadges = (items) => {
            try {
                const totalItems = items.reduce((sum, item) => sum + item.quantity, 0);
                badges.forEach(badge => {
                    badge.textContent = String(totalItems);
                    if (totalItems > 0) {
                        badge.classList.add('has-items');
                    } else {
                        badge.classList.remove('has-items');
                    }
                });
            } catch (error) {
                console.error('Error updating cart badges:', error);
                // Set default state in case of error
                badges.forEach(badge => {
                    badge.textContent = '0';
                    badge.classList.remove('has-items');
                });
            }
        }

        cart.subscribe(updateBadges);
        } catch (error) {
            console.error('Error initializing header:', error);
        }
    });
</script>
