---
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  imageSrc?: string;
  partNumbers?: string[];
}

const { title, description, imageSrc, partNumbers = [] } = Astro.props;

const jsonLD: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description,
  brand: { '@type': 'Brand', name: SITE_TITLE },
  url: new URL(Astro.url.pathname, Astro.site).href,
};
if (imageSrc) jsonLD.image = new URL(imageSrc, Astro.site).href;
if (partNumbers.length) jsonLD.mpn = partNumbers[0];
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
