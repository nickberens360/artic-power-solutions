---
import { SITE_TITLE } from '../consts';

interface PartData {
    title: string;
    partNumber: string;
    description: string;
    heroImage?: { src: string } | string;
    price?: string;
    currency?: string;
    inStock?: boolean;
}

interface Props {
    part: { data: PartData };
}

const { part } = Astro.props;
const { title, partNumber, description, heroImage, price, currency = 'USD', inStock } = part.data;

// Default image if heroImage is not set
// Handle both object with src property and direct string URL
const imageSrc = heroImage 
  ? typeof heroImage === 'string' 
    ? heroImage 
    : new URL(heroImage.src, Astro.site).href 
  : new URL('/placeholder-image.jpg', Astro.site).href;

const jsonLD = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": title,
    "sku": partNumber,
    "description": description,
    "image": imageSrc,
    "brand": {
    "@type": "Brand",
    "name": SITE_TITLE
    },
    "url": new URL(Astro.url.pathname, Astro.site).href,
    ...(price ? {
      "offers": {
        "@type": "Offer",
        "url": new URL(Astro.url.pathname, Astro.site).href,
        "priceCurrency": currency,
        "price": Number(price).toFixed(2),
        "itemCondition": "https://schema.org/NewCondition",
        ...(inStock === undefined ? {} : { "availability": inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock" }),
        "seller": { "@type": "Organization", "name": SITE_TITLE }
      }
    } : {}),
};
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
