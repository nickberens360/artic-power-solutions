---
// src/components/ServiceCard.astro
import { Image } from 'astro:assets';

export interface Props {
    image: ImageMetadata;
    imageAlt: string;
    title: string;
    description: string;
    listItems: string[];
    listHeading?: string;
    buttonText: string;
    buttonUrl: string;
    class?: string;
}

const {
    image,
    imageAlt,
    title,
    description,
    listItems,
    listHeading,
    buttonText,
    buttonUrl,
    class: className
} = Astro.props;
---

<div class:list={[className]}>
  <div class="bg-card border border-card-border rounded-xl shadow-sm overflow-hidden h-full flex flex-col">
    <Image
        src={image}
        alt={imageAlt}
        class="w-full h-64 object-cover rounded-none"
    />
    <div class="p-8 flex-grow">
      <h3 class="text-2xl font-bold text-foreground mb-4">{title}</h3>
      <p class="text-muted-foreground mb-4">{description}</p>
      {listHeading && <h4 class="font-semibold text-foreground mb-2">{listHeading}</h4>}
      <ul class="list-disc list-inside text-muted-foreground mb-6 space-y-1 pl-4 marker:text-primary">
          {listItems.map(item => (
              <li>{item}</li>
          ))}
      </ul>
    </div>
    <div class="p-8 pt-0">
      <a
          href={buttonUrl}
          class="btn btn-primary"
      >
          {buttonText}
      </a>
    </div>
  </div>
</div>
