---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import fallBackImage from '../assets/parts/placeholder.png';

interface Props {
  part: CollectionEntry<'parts'>;
}

const { part } = Astro.props;
const slug = part.id.replace(/\.md$/, '');
const image = part.data.heroImage ?? fallBackImage;
---
<a href={`/parts/${slug}`} class="card">
  <div class="bg-gray-800 p-4">
    <Image src={image} alt={part.data.title} width={300} height={300} loading="lazy" />
  </div>
  <div class="card-content text-white">
    <span class="category">{part.data.category}</span>
    <h2>{part.data.title}</h2>
    <p class="summary">{part.data.description}</p>
    <span class="cta">View details &amp; request a quote &rarr;</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background: #1f2937;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    text-decoration: none;
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.2);
  }
  .card img {
    width: 100%;
    height: 220px;
    object-fit: contain;
  }
  .card-content {
    padding: 1rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
  }
  h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .summary {
    font-size: 0.95rem;
    color: #d1d5db;
    flex: 1;
  }
  .cta {
    color: var(--accent);
    font-weight: 600;
  }
</style>
