---
// Import a fallback image from your assets directory.
// Make sure you have an image file at this location.
import fallBackImage from '../assets/parts/placeholder.png';
import {isFeatureEnabled} from '../utils/featureFlags';
const {product} = Astro.props;

const price = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: product.priceRange.minVariantPrice.currencyCode,
}).format(product.priceRange.minVariantPrice.amount);

// Get the primary product image, if it exists
const productImage = product.images.edges[0]?.node;

// ** Fallback Logic **
// Use the product image URL if available, otherwise use the fallback image's source.
const imageSrc = productImage ? productImage.url : fallBackImage.src;
// Use the product image's alt text or the product title.
const altText = productImage ? (productImage.altText || product.title) : product.title;
---
{(isFeatureEnabled('ENABLE_SHOP') || product.buyUrl) && (
<a
    href={`/parts/${product.handle}`}
    class="card"
>
  <div class="card-media">
    <img
        src={imageSrc}
        alt={altText}
        width="300"
        height="300"
        loading="lazy"
    />
  </div>
  <div class="card-content">
    <h2>{product.title}</h2>
    <p class="price">{price}</p>

  </div>
</a>
    )}
{!isFeatureEnabled('ENABLE_SHOP') && !product.buyUrl && (
<div
    class="card"
>
  <div class="card-media">
    <img
        src={imageSrc}
        alt={altText}
        width="300"
        height="300"
        loading="lazy"
    />
  </div>
  <div class="card-content">
    <h2>{product.title}</h2>
    <p class="price">
      <a
          href="mailto:sales@articpowersolutions.com"
          target="_blank"
      >Contact for Pricing
      </a>
    </p>

  </div>
</div>
    )}

<style>
    .card {
        background: hsl(var(--card));
        border: 1px solid hsl(var(--card-border));
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: hsl(var(--card-foreground));
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.2s, transform .2s;
    }

    a.card:hover {
        box-shadow: 0px 10px 15px -3px hsl(220 13% 13% / .08), 0px 4px 6px -4px hsl(220 13% 13% / .06);
    }

    .card-media {
        background: hsl(var(--background));
        padding: 1rem;
        border-bottom: 1px solid hsl(var(--card-border));
    }

    .card img {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: contain;
        border-radius: 0;
    }

    .card-content {
        padding: 1rem 1.25rem 1.25rem;
    }

    .card-content h2 {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.4;
        margin: 0 0 0.5rem;
        color: hsl(var(--foreground));
    }

    a.card:hover .card-content h2 {
        color: hsl(var(--primary));
    }

    .price {
        font-weight: 700;
        font-size: 1.1rem;
        color: hsl(var(--primary));
        margin: 0;
    }
</style>
